{
  "name": "dsh-bili-studio",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "B 站自主创作工作室：选题 → 脚本 → 出片 → 审批 → 投稿，带节奏调度与一次性审批令牌",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "python",
    "integrations",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "STUDIO-API.md",
    "SELF-CHECK.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
